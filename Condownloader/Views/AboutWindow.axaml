<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="500" Height="475" CanResize="False" WindowStartupLocation="CenterOwner"
        x:Class="Condownloader.AboutWindow" Icon="/Assets/condownloader.ico" RequestedThemeVariant="Dark"
        Title="About Condownloader">
  <Window.Background>
    <LinearGradientBrush>
      <LinearGradientBrush.GradientStops>
        <GradientStop Offset="0" Color="#9E3432"/>
        <GradientStop Offset="1" Color="#6B201F"/>
      </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
  </Window.Background>
  <StackPanel Margin="20" Spacing="5">
    <Image Source="/Assets/condownloaderwordmark.png" Width="400" HorizontalAlignment="Left"/>
    <TextBlock Margin="0,10,0,0" Text="Version 2.0.0.0" FontSize="20" FontWeight="Bold"/>
    <TextBlock Text="by Squidhouse Software (and open source contributors)"/>
    <TextBlock Text="Licensed under GPL v3"/>
    
    <TextBlock Margin="0,20,0,0" Text="Thank you for using Condownloader ❤️" FontWeight="Bold"/>
    
    <Button Margin="0,20,0,0" Content="Releases page (get updated versions)" Click="Button_Click"/>
    <Button Content="Report an issue" Click="Button_Click_1"/>
    <Button Content="View license and source code" Click="Button_Click_2"/>
    <!--<Button Content="Condownloader website"/>-->
  </StackPanel>
   
</Window>
